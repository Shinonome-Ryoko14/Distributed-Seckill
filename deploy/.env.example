# MySQL（docker-compose 与本地服务共用）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=seckill

# 应用：服务通过 internal/config 读取；MYSQL_PASSWORD 缺省时回退 MYSQL_ROOT_PASSWORD
JWT_SECRET=
JWT_TTL=24h
JWT_ISSUER=distributed-seckill
LOG_FORMAT=json
LOG_LEVEL=info

# Redis (docker-compose 与本地服务共用)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# product 商品详情缓存
PRODUCT_CACHE_TTL=5m
PRODUCT_CACHE_NULL_TTL=1m

# 每个服务的监听地址（默认 :8080），按启动的服务单独设置：
# user:    HTTP_ADDR=:8081
# product: HTTP_ADDR=:8082
