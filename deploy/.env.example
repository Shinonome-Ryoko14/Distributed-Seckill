# MySQL（docker-compose 与本地服务共用）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=seckill

# 应用：服务通过 internal/config 读取；MYSQL_PASSWORD 缺省时回退 MYSQL_ROOT_PASSWORD
JWT_SECRET=
JWT_TTL=24h
JWT_ISSUER=distributed-seckill
LOG_FORMAT=json
LOG_LEVEL=info

# 每个服务的监听地址（默认 :8080）；例如 user 服务：HTTP_ADDR=:8081
# HTTP_ADDR=:8081
