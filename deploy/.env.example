# MySQL（docker-compose、应用、Makefile 共用；库名统一用 MYSQL_DATABASE）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=seckill
# 可选：应用与 make migrate 的完整 DSN 覆盖（go-sql-driver 格式，不带 mysql://；
# make migrate 会自动补 mysql://）。未设置时由下面的组件变量组合。
# MYSQL_DSN=root:password@tcp(127.0.0.1:3307)/seckill?charset=utf8mb4&parseTime=true&loc=Local
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_USER=root
# MYSQL_PASSWORD=  # 缺省回退 MYSQL_ROOT_PASSWORD
# 应用连接超时（MYSQL_DSN 未显式设置对应超时时使用默认值）
# MYSQL_DIAL_TIMEOUT=3s
# MYSQL_READ_TIMEOUT=5s
# MYSQL_WRITE_TIMEOUT=5s

# 应用：服务通过 internal/config 读取
JWT_SECRET=
JWT_TTL=24h
JWT_ISSUER=distributed-seckill
LOG_FORMAT=json
LOG_LEVEL=info

# Redis (docker-compose 与本地服务共用)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# product 商品详情缓存
PRODUCT_CACHE_TTL=5m
PRODUCT_CACHE_NULL_TTL=1m

# 每个服务的监听地址（默认 :8080），按启动的服务单独设置：
# user:    HTTP_ADDR=:8081
# product: HTTP_ADDR=:8082
